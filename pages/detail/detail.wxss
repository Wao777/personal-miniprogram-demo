/* ---------- 顶部 ---------- */

.top {
  position: relative;
  margin: 0 24rpx;
  border-radius: 0 0 28rpx 28rpx;
  overflow: hidden;
  background: linear-gradient(158deg, #1E5145 0%, #14352E 52%, #0C221D 100%);
}

.top__cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.top__veil {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(158deg, rgba(12, 34, 29, 0.74) 0%, rgba(12, 34, 29, 0.92) 100%);
}

.top__inner {
  position: relative;
  z-index: 2;
  padding: 44rpx 36rpx 46rpx;
}

.top__badge {
  display: inline-block;
  padding: 5rpx 18rpx;
  border: 1rpx solid rgba(217, 192, 140, 0.55);
  border-radius: 4rpx;
  color: #D9C08C;
  font-size: 21rpx;
  letter-spacing: 3rpx;
}

.top__title {
  margin-top: 20rpx;
  color: #F7F3E8;
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
  line-height: 1.3;
}

.top__sub {
  margin-top: 10rpx;
  color: rgba(247, 243, 232, 0.7);
  font-size: 25rpx;
  letter-spacing: 2rpx;
}

.top__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 24rpx;
  color: rgba(247, 243, 232, 0.6);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.top__sep {
  color: rgba(217, 192, 140, 0.7);
}

/* ---------- 介绍 ---------- */

.intro {
  font-size: 27rpx;
  color: var(--text-sub);
  line-height: 1.86;
  letter-spacing: 0.6rpx;
  text-align: justify;
}

/* ---------- 日程 ---------- */

.timeline {
  padding: 26rpx 30rpx 10rpx;
}

.timeline__row {
  display: flex;
  gap: 22rpx;
}

.timeline__rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto;
  padding-top: 12rpx;
}

.timeline__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: var(--gold);
  transform: rotate(45deg);
}

.timeline__line {
  flex: 1;
  width: 1rpx;
  margin: 8rpx 0;
  background: var(--line);
}

.timeline__body {
  flex: 1;
  padding-bottom: 30rpx;
}

.timeline__head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.timeline__day {
  font-size: 21rpx;
  color: var(--gold);
  letter-spacing: 1rpx;
}

.timeline__title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 1rpx;
}

.timeline__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-sub);
  line-height: 1.62;
}

/* ---------- 课业 ---------- */

.tracks {
  padding: 8rpx 30rpx;
}

.tracks__row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.tracks__row:last-child {
  border-bottom: none;
}

.tracks__icon {
  flex: 0 0 auto;
  align-self: center;
  width: 48rpx;
  height: 48rpx;
}

.tracks__mark {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin-top: 16rpx;
  border-radius: 2rpx;
  background: var(--gold);
  transform: rotate(45deg);
}

.tracks__body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tracks__name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 2rpx;
}

.tracks__desc {
  font-size: 23rpx;
  color: var(--text-sub);
}

/* ---------- 须知 ---------- */

.notices {
  padding: 12rpx 30rpx;
}

.notices__row {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.notices__row:last-child {
  border-bottom: none;
}

.notices__index {
  flex: 0 0 34rpx;
  height: 34rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: rgba(31, 75, 67, 0.07);
  color: var(--primary);
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}

.notices__text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

/* ---------- 行前信息 ---------- */

.facts {
  padding: 10rpx 30rpx;
}

.facts__row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.facts__row:last-child {
  border-bottom: none;
}

.facts__key {
  flex: 0 0 84rpx;
  font-size: 24rpx;
  color: var(--text-mute);
  letter-spacing: 2rpx;
}

.facts__val {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

.state__ring {
  width: 46rpx;
  height: 46rpx;
  border: 3rpx solid var(--line);
  border-top-color: var(--jade);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
