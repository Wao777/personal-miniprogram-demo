/* ---------- 山门 ---------- */

.hero {
  position: relative;
  margin: 0 24rpx;
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
  background: linear-gradient(158deg, #1E5145 0%, #14352E 46%, #0C221D 100%);
}

.hero__cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero__veil {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(158deg, rgba(12, 34, 29, 0.72) 0%, rgba(12, 34, 29, 0.9) 100%);
}

.hero__ridge {
  position: absolute;
  border-radius: 50% 50% 0 0;
  background: rgba(255, 255, 255, 0.045);
}

.hero__ridge--far {
  width: 700rpx;
  height: 320rpx;
  left: -120rpx;
  bottom: -170rpx;
  transform: rotate(-6deg);
}

.hero__ridge--near {
  width: 560rpx;
  height: 260rpx;
  right: -140rpx;
  bottom: -150rpx;
  background: rgba(255, 255, 255, 0.03);
  transform: rotate(8deg);
}

.hero__inner {
  position: relative;
  z-index: 2;
  padding: 56rpx 40rpx 88rpx;
}

.hero__badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border: 1rpx solid rgba(217, 192, 140, 0.55);
  border-radius: 4rpx;
  color: #D9C08C;
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.hero__title {
  margin-top: 26rpx;
  color: #F7F3E8;
  font-size: 60rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  line-height: 1.24;
}

.hero__sub {
  margin-top: 14rpx;
  color: rgba(247, 243, 232, 0.72);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.hero__rule {
  width: 64rpx;
  height: 2rpx;
  margin: 30rpx 0 22rpx;
  background: linear-gradient(90deg, #C9A961, rgba(201, 169, 97, 0));
}

.hero__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  color: rgba(247, 243, 232, 0.62);
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.hero__sep {
  color: rgba(217, 192, 140, 0.7);
}

.hero__seal {
  position: absolute;
  right: 34rpx;
  bottom: 34rpx;
  z-index: 2;
  width: 92rpx;
  height: 92rpx;
  border: 2rpx solid rgba(201, 169, 97, 0.42);
  border-radius: 6rpx;
  color: rgba(217, 192, 140, 0.78);
  font-size: 44rpx;
  line-height: 88rpx;
  text-align: center;
  letter-spacing: 0;
  transform: rotate(-4deg);
}

/* ---------- 名额 ---------- */

.stats {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  margin: -56rpx 28rpx 0;
  padding: 30rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(18, 51, 44, 0.07);
}

.stats__cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
}

.stats__cell::after {
  content: '';
  position: absolute;
  right: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: var(--line);
}

.stats__cell:last-child::after {
  display: none;
}

.stats__num {
  font-size: 42rpx;
  font-weight: 600;
  color: var(--primary);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.stats__lab {
  font-size: 21rpx;
  color: var(--text-mute);
  letter-spacing: 1rpx;
}

/* ---------- 山中四事 ---------- */

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.grid__item {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  width: calc(50% - 9rpx);
  height: 270rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx 26rpx 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 22rpx rgba(18, 51, 44, 0.04);
}

/* 底纹：四张已按卡片比例 1.25:1 预处理好，统一铺满 */
.grid__bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.grid__wash {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.74) 52%, rgba(255, 255, 255, 0.56) 100%);
}

.grid__no {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: var(--gold);
  letter-spacing: 3rpx;
}

.grid__title {
  position: relative;
  z-index: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 1rpx;
}

.grid__desc {
  position: relative;
  z-index: 1;
  font-size: 23rpx;
  color: var(--text-sub);
  line-height: 1.62;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 五门课业 ---------- */

.tracks {
  padding: 8rpx 30rpx;
}

.tracks__row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.tracks__row:last-child {
  border-bottom: none;
}

.tracks__icon {
  flex: 0 0 auto;
  align-self: center;
  width: 48rpx;
  height: 48rpx;
}

.tracks__mark {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin-top: 16rpx;
  border-radius: 2rpx;
  background: var(--gold);
  transform: rotate(45deg);
}

.tracks__body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tracks__name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 2rpx;
}

.tracks__desc {
  font-size: 23rpx;
  color: var(--text-sub);
}

/* ---------- 报名流程 ---------- */

.steps {
  padding: 30rpx 30rpx 14rpx;
}

.steps__row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.steps__rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto;
}

.steps__index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 4rpx;
  background: rgba(31, 75, 67, 0.07);
  color: var(--primary);
  font-size: 22rpx;
  line-height: 44rpx;
  text-align: center;
  font-weight: 600;
}

.steps__line {
  width: 1rpx;
  height: 40rpx;
  background: var(--line);
}

.steps__text {
  flex: 1;
  font-size: 27rpx;
  color: var(--text);
  line-height: 44rpx;
  letter-spacing: 1rpx;
}

/* ---------- 加载态 ---------- */

.state__ring {
  width: 46rpx;
  height: 46rpx;
  border: 3rpx solid var(--line);
  border-top-color: var(--jade);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
